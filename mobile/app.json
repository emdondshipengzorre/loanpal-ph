{
  "expo": {
    "name": "LoanPal PH",
    "slug": "loanpal-ph",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loanpal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.loanpal.ph"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.loanpal.ph",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "ACCESS_NETWORK_STATE",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "LoanPal needs camera access to scan loan documents via OCR." }
      ],
      [
        "expo-notifications",
        { "icon": "./assets/images/notification-icon.png", "color": "#09090b" }
      ],
      [
        "expo-local-authentication",
        { "faceIDPermission": "Allow LoanPal to use Face ID to protect your financial data." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "LoanPal needs photo access to scan loan documents from your gallery." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
